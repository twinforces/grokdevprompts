{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "get_command_or_subagent_output|wait_commands_or_subagents|GetTaskOutput|WaitTasks",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT}/hooks/bin/wait-credit-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|write|search_replace|hashline_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT}/hooks/bin/guard-write.py\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT}/hooks/bin/ensure-git-repo.py\"",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT}/hooks/bin/ensure-git-repo.py\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "get_command_or_subagent_output|wait_commands_or_subagents|run_terminal_command|spawn_subagent|kill_command_or_subagent|Bash|Task|GetTaskOutput|WaitTasks",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT}/hooks/bin/wait-credit-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|write|search_replace|hashline_edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GROK_PLUGIN_ROOT}/hooks/bin/post-edit-check.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
